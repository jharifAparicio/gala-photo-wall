---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SwipeDeck from "../../components/admin/SwipeDeck";

export const prerender = false;

const user = Astro.locals.user;
---

<BaseLayout
    title="Triaje de Fotos | Jurado"
    class="p-4 max-w-md mx-auto justify-between min-h-screen"
>
    <!-- Barra superior del Jurado -->
    <header
        class="flex items-center justify-between pb-3 border-b border-neutral-800/80"
    >
        <div class="flex items-center gap-2.5">
            <div
                class="w-8 h-8 rounded-full bg-amber-400/10 border border-amber-400/20 flex items-center justify-center font-bold text-amber-400 text-xs"
            >
                {user?.username?.charAt(0).toUpperCase() || "J"}
            </div>
            <div>
                <p class="text-xs font-bold text-white leading-tight">
                    {user?.name || user?.username}
                </p>
                <span class="text-[10px] text-emerald-400 font-medium"
                    >● Jurado Activo</span
                >
            </div>
        </div>

        <form method="POST" action="/api/auth/logout">
            <button
                type="submit"
                class="text-xs text-neutral-400 hover:text-rose-400 py-1.5 px-3 rounded-lg bg-neutral-900 border border-neutral-800 transition"
            >
                Salir
            </button>
        </form>
    </header>

    <!-- Mazo de Moderación Tinder -->
    <main class="w-full flex-1 flex flex-col justify-center py-4">
        <SwipeDeck client:load />
    </main>

    <footer class="text-center text-[11px] text-neutral-500 py-1">
        Gala Jóvenes Embajadores 2026
    </footer>
</BaseLayout>
