---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Gala 2026 | Sube tu foto"
	class="p-4 max-w-md mx-auto justify-between"
>
	<header class="text-center pt-6">
		<span
			class="text-[10px] font-bold uppercase tracking-widest text-amber-400/80 bg-amber-400/10 px-3 py-1 rounded-full border border-amber-400/20"
		>
			Jóvenes Embajadores 2026
		</span>
		<h1 class="text-2xl font-black tracking-tight text-white mt-3">
			Muro de Fotos
		</h1>
		<p class="text-xs text-neutral-400 mt-1">
			Comparte tus mejores momentos en la pantalla gigante
		</p>
	</header>

	<!-- Aquí irá el componente CameraUploader del Paso 3 -->
	<main class="my-auto py-8">
		<div
			class="border-2 border-dashed border-neutral-800 rounded-3xl p-8 text-center bg-neutral-900/40"
		>
			<p class="text-sm text-neutral-400">
				Captura de cámara lista para el Paso 3
			</p>
		</div>
	</main>

	<footer class="text-center pb-6 text-xs text-neutral-600">
		<p>© 2026 Gala Jóvenes Embajadores</p>
		<a
			href="/login"
			class="text-neutral-500 hover:text-neutral-400 text-[11px] mt-2 inline-block transition"
		>
			Acceso Jurados
		</a>
	</footer>
</BaseLayout>
