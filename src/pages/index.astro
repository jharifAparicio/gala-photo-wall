---
import BaseLayout from "../layouts/BaseLayout.astro";
import CameraUploader from "../components/capture/CameraUploader";

export const prerender = false;
---

<BaseLayout
	title="Gala 2026 | Comparte tu foto"
	class="p-4 max-w-md mx-auto justify-between min-h-screen"
>
	<header class="text-center pt-6">
		<span
			class="text-[10px] font-bold uppercase tracking-widest text-amber-400/90 bg-amber-400/10 px-3 py-1 rounded-full border border-amber-400/20"
		>
			Jóvenes Embajadores 2026
		</span>
		<h1 class="text-2xl font-black tracking-tight text-white mt-3">
			Muro en Vivo
		</h1>
		<p class="text-xs text-neutral-400 mt-1">
			Comparte tus momentos de la noche en la pantalla gigante
		</p>
	</header>

	<main class="w-full my-auto py-6">
		<CameraUploader client:load />
	</main>

	<footer class="text-center pb-6 text-xs text-neutral-600">
		<p>© 2026 Gala Jóvenes Embajadores</p>
		<a
			href="/login"
			class="text-neutral-500 hover:text-neutral-400 text-[11px] mt-2 inline-block transition"
		>
			Acceso Jurados
		</a>
	</footer>
</BaseLayout>
